rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        request.auth.token.keys().hasAny(['admin']) &&
        request.auth.token.admin == true;
    }

    match /products/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        productId.matches('^[A-Za-z0-9_-]{1,128}$') &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType == 'image/webp' &&
        fileName.matches('^[A-Za-z0-9_-]{1,200}[.]webp$') &&
        request.resource.metadata.adminUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /returns/{userId}/{orderId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() &&
        request.auth.uid == userId &&
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }
  }
}
