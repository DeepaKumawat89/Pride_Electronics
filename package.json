{
  "name": "pride-electronics",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:routes": "node --test tests/protectedRoutes.test.mjs",
    "test:errors": "node --test tests/auth-errors.test.mjs",
    "test:customer": "node --test tests/customer-domain.test.mjs",
    "test:taxonomy": "node --test tests/catalog-taxonomy.test.mjs",
    "test:specifications": "node --test tests/product-specifications.test.mjs tests/product-specification-templates.test.mjs",
    "test:variants": "node --test tests/product-variants.test.mjs",
    "test:ui": "node --test tests/browser-smoke.test.mjs",
    "test:admin": "node --test tests/admin-authorization.test.mjs",
    "test:auth": "npx -y firebase-tools@14.19.1 emulators:exec --only auth --project demo-pride-electronics \"node --test tests/firebase-auth.test.mjs\"",
    "test:rules": "npx -y firebase-tools@14.19.1 emulators:exec --only firestore --project demo-pride-electronics \"node --test tests/firestore.rules.test.mjs\"",
    "test:storage": "npx -y firebase-tools@14.19.1 emulators:exec --only storage --project demo-pride-electronics \"node --test tests/storage.rules.test.mjs\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^12.17.1",
    "india-edu-cities-data": "1.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  }
}
