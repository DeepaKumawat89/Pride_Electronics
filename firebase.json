{
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/",
        "function": {
          "functionId": "publicPage",
          "region": "asia-south1"
        }
      },
      {
        "source": "/products",
        "function": {
          "functionId": "publicPage",
          "region": "asia-south1"
        }
      },
      {
        "source": "/categories",
        "function": {
          "functionId": "publicPage",
          "region": "asia-south1"
        }
      },
      {
        "source": "/category/**",
        "function": {
          "functionId": "publicPage",
          "region": "asia-south1"
        }
      },
      {
        "source": "/product/**",
        "function": {
          "functionId": "publicPage",
          "region": "asia-south1"
        }
      },
      {
        "source": "/sitemap.xml",
        "function": {
          "functionId": "sitemap",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
