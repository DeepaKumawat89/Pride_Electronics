rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
// products/{productId}: publicly readable catalog documents. Admin-only full
// writes require name/category metadata, positive GST-exclusive price,
// pricingModel "gst-exclusive-v1", priceIncludesTax false, GST rate 0..100,
// inventory, specifications, and 1..3 product images scoped to productId.
// users/{uid}: private customer profile, address, cart, and preference data.
// orders, returns: owner/admin-readable commerce records; trusted backend
// writes authoritative order, payment, tax, and embedded invoice snapshots.
// categories, subcategories, coupons, settings, reviews: storefront/config
// data with collection-specific read restrictions and admin/backend writes.
// settings/invoice: public seller/tax information used for checkout display;
// writes are backend-only after callable admin authorization and validation.
// refunds, inventoryHistory: admin-only operational records.
// invoices, paymentIntents, stockReservations, couponUsages, _authPhoneIndex:
// trusted-backend-only records (default denied to clients).
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.keys().hasAny(['admin']) &&
        request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasActiveCustomerAccount() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['status']) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'Active'
      );
    }

    function uidUnchanged(userId) {
      return request.resource.data.uid == userId;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function backendGstFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['gstDetails', 'gstProfiles']);
    }

    function optionalString(data, field, maxSize) {
      return !data.keys().hasAny([field]) ||
        (data[field] is string && data[field].size() <= maxSize);
    }

    function optionalList(data, field, maxSize) {
      return !data.keys().hasAny([field]) ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    function optionalNonNegativeNumber(data, field) {
      return !data.keys().hasAny([field]) ||
        (data[field] is number && data[field] >= 0);
    }

    function isCurrencyAmount(value, allowZero) {
      return value is number &&
        (allowZero ? value >= 0 : value > 0) &&
        value * 100 == int(value * 100);
    }

    function hasValidHsnCode(data) {
      return !data.keys().hasAny(['hsnCode']) ||
        (data.hsnCode is string &&
          (data.hsnCode == '' || data.hsnCode.matches('^[0-9]{8}$')));
    }

    function isValidProductImagePath(path, productId) {
      return productId.matches('^[A-Za-z0-9_-]{1,128}$') &&
        path is string && path.size() <= 500 &&
        (path == '' || path.matches(
          '^products/' + productId + '/[A-Za-z0-9_.-]{1,200}[.](jpg|jpeg|png|webp)$'
        ));
    }

    function hasValidProductImages(data, productId) {
      return data.keys().hasAll(['image', 'images', 'imageStoragePaths']) &&
        data.image is string && data.image.matches('^https://.*') &&
        data.images is list &&
        data.images.size() >= 1 && data.images.size() <= 3 &&
        data.imageStoragePaths is list &&
        data.imageStoragePaths.size() == data.images.size() &&
        data.image == data.images[0] &&
        data.images[0] is string && data.images[0].size() <= 2000 &&
        data.images[0].matches('^https://.*') &&
        (data.images.size() < 2 ||
          (data.images[1] is string && data.images[1].size() <= 2000 &&
            data.images[1].matches('^https://.*'))) &&
        (data.images.size() < 3 ||
          (data.images[2] is string && data.images[2].size() <= 2000 &&
            data.images[2].matches('^https://.*'))) &&
        isValidProductImagePath(data.imageStoragePaths[0], productId) &&
        (data.imageStoragePaths.size() < 2 ||
          isValidProductImagePath(data.imageStoragePaths[1], productId)) &&
        (data.imageStoragePaths.size() < 3 ||
          isValidProductImagePath(data.imageStoragePaths[2], productId));
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll([
          'name', 'brand', 'description', 'categoryId', 'category',
          'subcategoryId', 'subcategory', 'price', 'pricingModel',
          'priceIncludesTax', 'taxRate', 'stock', 'modelNumber', 'specs',
          'image', 'images', 'imageStoragePaths'
        ]) &&
        data.name is string && data.name.size() >= 3 && data.name.size() <= 200 &&
        data.brand is string && data.brand.size() > 0 && data.brand.size() <= 100 &&
        data.description is string && data.description.size() >= 20 && data.description.size() <= 5000 &&
        data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 200 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 200 &&
        data.subcategoryId is string && data.subcategoryId.size() > 0 && data.subcategoryId.size() <= 200 &&
        data.subcategory is string && data.subcategory.size() > 0 && data.subcategory.size() <= 200 &&
        isCurrencyAmount(data.price, false) &&
        data.pricingModel == 'gst-exclusive-v1' &&
        data.priceIncludesTax == false &&
        isCurrencyAmount(data.taxRate, true) && data.taxRate <= 100 &&
        data.stock is int && data.stock >= 0 &&
        data.modelNumber is string && data.modelNumber.size() > 0 && data.modelNumber.size() <= 200 &&
        hasValidHsnCode(data) &&
        hasValidProductImages(data, productId) &&
        data.specs is list && data.specs.size() > 0 && data.specs.size() <= 100 &&
        (!data.keys().hasAny(['sku']) ||
          (data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100)) &&
        !data.keys().hasAny(['originalPrice', 'discount']);
    }

    function isLegacyProductOperationalUpdate(productId) {
      return !isValidProduct(resource.data, productId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stock', 'reservedStock', 'variants', 'rating', 'reviewsCount',
          'categoryId', 'category', 'subcategoryId', 'subcategory', 'updatedAt',
          'hsnCode', 'enabled'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['hsnCode']) ||
          hasValidHsnCode(request.resource.data));
    }

    function isValidUser(data, userId) {
      return data.keys().hasOnly([
          'uid', 'name', 'phone', 'phoneNormalized', 'email', 'emailVerified',
          'role', 'createdAt', 'updatedAt', 'dob', 'gender', 'photo', 'status',
          'membershipRole', 'joinedDate', 'registrationDate', 'ordersCount',
          'totalSpentValue', 'lastOrderAt', 'wishlistIds', 'addresses',
          'paymentMethods', 'cartItems', 'savedCartItems', 'gstDetails',
          'gstProfiles'
        ]) &&
        data.uid == userId &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.email is string && data.email.size() <= 320 &&
        data.role == 'customer' &&
        optionalString(data, 'phone', 10) &&
        optionalString(data, 'phoneNormalized', 10) &&
        optionalString(data, 'dob', 10) &&
        optionalString(data, 'gender', 30) &&
        optionalString(data, 'photo', 2000) &&
        optionalString(data, 'membershipRole', 50) &&
        optionalString(data, 'joinedDate', 40) &&
        optionalString(data, 'registrationDate', 40) &&
        optionalString(data, 'lastOrderAt', 40) &&
        (!data.keys().hasAny(['status']) || data.status in ['Active', 'Disabled', 'Suspended']) &&
        (!data.keys().hasAny(['emailVerified']) || data.emailVerified is bool) &&
        optionalNonNegativeNumber(data, 'ordersCount') &&
        optionalNonNegativeNumber(data, 'totalSpentValue') &&
        optionalList(data, 'wishlistIds', 200) &&
        optionalList(data, 'addresses', 20) &&
        optionalList(data, 'paymentMethods', 10) &&
        optionalList(data, 'cartItems', 100) &&
        optionalList(data, 'savedCartItems', 100) &&
        (!data.keys().hasAny(['gstDetails']) ||
          data.gstDetails == null || data.gstDetails is map) &&
        (!data.keys().hasAny(['gstProfiles']) ||
          (data.gstProfiles is list && data.gstProfiles.size() <= 5));
    }

    function isValidClientProfileCreate(data, userId) {
      return data.keys().hasOnly([
          'uid', 'name', 'phone', 'phoneNormalized', 'email', 'emailVerified',
          'role', 'photo', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasAll([
          'uid', 'name', 'email', 'emailVerified', 'role', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == userId &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        request.auth.token.keys().hasAll(['email', 'email_verified']) &&
        data.email == request.auth.token.email &&
        data.emailVerified == request.auth.token.email_verified &&
        data.role == 'customer' &&
        data.createdAt == request.time &&
        data.updatedAt == request.time &&
        optionalString(data, 'photo', 2000) &&
        ((!data.keys().hasAny(['phone', 'phoneNormalized'])) ||
          (data.keys().hasAll(['phone', 'phoneNormalized']) &&
            data.phone is string && data.phone.matches('^[6-9][0-9]{9}$') &&
            data.phoneNormalized == data.phone));
    }

    function owns(resourceData) {
      return hasActiveCustomerAccount() && resourceData.userId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data, productId);
      allow update: if isAdmin() &&
        (isValidProduct(request.resource.data, productId) ||
          isLegacyProductOperationalUpdate(productId));
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || settingId in [
        'marketing',
        'shipping',
        'invoice',
        'storefront'
      ];
      allow write: if settingId != 'invoice' && (
        (settingId == 'admin' && isAdmin()) ||
        (settingId == 'marketing' && isAdmin()) ||
        (settingId == 'storefront' && isAdmin())
      );
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'Published' || owns(resource.data);
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if isAdmin();
    }

    match /returns/{returnId} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if isAdmin();
    }

    match /refunds/{refundId} {
      allow read, write: if isAdmin();
    }

    match /inventoryHistory/{entryId} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() ||
        (isOwner(userId) && hasActiveCustomerAccount());
      allow create: if isOwner(userId) &&
        isValidClientProfileCreate(request.resource.data, userId);
      allow update: if backendGstFieldsUnchanged() &&
        isAdmin() && uidUnchanged(userId) &&
        uidNotModified() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) &&
        isValidUser(request.resource.data, userId);
      allow delete: if false;
    }

    match /couponUsages/{usageId} {
      allow read, write: if false;
    }

    match /_authPhoneIndex/{phone} {
      allow read, write: if false;
    }

    match /_authRateLimits/{key} {
      allow read, write: if false;
    }
  }
}
