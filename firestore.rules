rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Public catalog: products, categories, subcategories, coupons and the
    // public settings documents. Admins write these records.
    // Private users/{uid}: identity strings, bounded account-state lists,
    // gstDetails (optional verified GST map), and gstProfiles (up to 5 verified
    // GST maps). Only the owner/admin can read; trusted functions perform normal
    // customer writes. GST maps require gstin, legalName, address, status,
    // verifiedAt, verificationProvider and verificationStatus strings.
    // Private orders/returns: backend-assigned userId plus server snapshots;
    // owners may read but customers cannot write.
    // Admin-only: refunds, inventoryHistory and admins.
    // Backend-only/default-denied: paymentIntents, stockReservations,
    // couponUsages and _authPhoneIndex.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        request.auth.token.keys().hasAny(['admin']) &&
        request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged(userId) {
      return request.resource.data.uid == userId;
    }

    function uidNotModified() {
      return request.resource.data.uid == resource.data.uid;
    }

    function backendGstFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['gstDetails', 'gstProfiles']);
    }

    function optionalString(data, field, maxSize) {
      return !data.keys().hasAny([field]) ||
        (data[field] is string && data[field].size() <= maxSize);
    }

    function optionalList(data, field, maxSize) {
      return !data.keys().hasAny([field]) ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    function optionalNonNegativeNumber(data, field) {
      return !data.keys().hasAny([field]) ||
        (data[field] is number && data[field] >= 0);
    }

    function isCurrencyAmount(value, allowZero) {
      return value is number &&
        (allowZero ? value >= 0 : value > 0) &&
        value * 100 == int(value * 100);
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'name', 'brand', 'description', 'categoryId', 'category',
          'subcategoryId', 'subcategory', 'originalPrice', 'price', 'stock',
          'modelNumber', 'specs'
        ]) &&
        data.name is string && data.name.size() >= 3 && data.name.size() <= 200 &&
        data.brand is string && data.brand.size() > 0 && data.brand.size() <= 100 &&
        data.description is string && data.description.size() >= 20 && data.description.size() <= 5000 &&
        data.categoryId is string && data.categoryId.size() > 0 && data.categoryId.size() <= 200 &&
        data.category is string && data.category.size() > 0 && data.category.size() <= 200 &&
        data.subcategoryId is string && data.subcategoryId.size() > 0 && data.subcategoryId.size() <= 200 &&
        data.subcategory is string && data.subcategory.size() > 0 && data.subcategory.size() <= 200 &&
        isCurrencyAmount(data.originalPrice, false) &&
        isCurrencyAmount(data.price, true) &&
        data.price <= data.originalPrice &&
        data.stock is int && data.stock >= 0 &&
        data.modelNumber is string && data.modelNumber.size() > 0 && data.modelNumber.size() <= 200 &&
        data.specs is list && data.specs.size() > 0 && data.specs.size() <= 100 &&
        (!data.keys().hasAny(['sku']) ||
          (data.sku is string && data.sku.size() > 0 && data.sku.size() <= 100)) &&
        (!data.keys().hasAny(['discount']) ||
          (isCurrencyAmount(data.discount, true) &&
            data.discount <= 100 &&
            int(data.price * 100) ==
              int(data.originalPrice * (100 - data.discount) + 0.5)));
    }

    function isLegacyProductOperationalUpdate() {
      return !isValidProduct(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stock', 'reservedStock', 'variants', 'rating', 'reviewsCount',
          'categoryId', 'category', 'subcategoryId', 'subcategory', 'updatedAt'
        ]);
    }

    function isValidUser(data, userId) {
      return data.keys().hasOnly([
          'uid', 'name', 'phone', 'phoneNormalized', 'email', 'emailVerified',
          'role', 'createdAt', 'updatedAt', 'dob', 'gender', 'photo', 'status',
          'membershipRole', 'joinedDate', 'registrationDate', 'ordersCount',
          'totalSpentValue', 'lastOrderAt', 'wishlistIds', 'addresses',
          'paymentMethods', 'cartItems', 'savedCartItems', 'gstDetails',
          'gstProfiles'
        ]) &&
        data.uid == userId &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.email is string && data.email.size() <= 320 &&
        data.role == 'customer' &&
        optionalString(data, 'phone', 10) &&
        optionalString(data, 'phoneNormalized', 10) &&
        optionalString(data, 'dob', 10) &&
        optionalString(data, 'gender', 30) &&
        optionalString(data, 'photo', 2000) &&
        optionalString(data, 'membershipRole', 50) &&
        optionalString(data, 'joinedDate', 40) &&
        optionalString(data, 'registrationDate', 40) &&
        optionalString(data, 'lastOrderAt', 40) &&
        (!data.keys().hasAny(['status']) || data.status in ['Active', 'Suspended']) &&
        (!data.keys().hasAny(['emailVerified']) || data.emailVerified is bool) &&
        optionalNonNegativeNumber(data, 'ordersCount') &&
        optionalNonNegativeNumber(data, 'totalSpentValue') &&
        optionalList(data, 'wishlistIds', 200) &&
        optionalList(data, 'addresses', 20) &&
        optionalList(data, 'paymentMethods', 10) &&
        optionalList(data, 'cartItems', 100) &&
        optionalList(data, 'savedCartItems', 100) &&
        (!data.keys().hasAny(['gstDetails']) ||
          data.gstDetails == null || data.gstDetails is map) &&
        (!data.keys().hasAny(['gstProfiles']) ||
          (data.gstProfiles is list && data.gstProfiles.size() <= 5));
    }

    function owns(resourceData) {
      return isAuthenticated() && resourceData.userId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() &&
        (isValidProduct(request.resource.data) || isLegacyProductOperationalUpdate());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /subcategories/{subcategoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAdmin() || settingId in [
        'marketing',
        'shipping',
        'invoice',
        'storefront'
      ];
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if isAdmin() || resource.data.status == 'Published' || owns(resource.data);
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if isAdmin();
    }

    match /returns/{returnId} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if isAdmin();
    }

    match /refunds/{refundId} {
      allow read, write: if isAdmin();
    }

    match /inventoryHistory/{entryId} {
      allow read, write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if false;
      allow update: if backendGstFieldsUnchanged() &&
        isAdmin() && uidUnchanged(userId) &&
        uidNotModified() &&
        isValidUser(request.resource.data, userId);
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId);
      allow write: if isAdmin();
    }

    match /couponUsages/{usageId} {
      allow read, write: if false;
    }

    match /_authPhoneIndex/{phone} {
      allow read, write: if false;
    }
  }
}
